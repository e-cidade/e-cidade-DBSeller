<?xml version='1.0' ?>

<consulta distinct="true">
  <campos>
    <campo campo="q202_sequencial"                               label="sequencial"        />
    <campo campo="q202_inscr"                                    label="inscricao"        />
    <campo campo="q202_dtinicial"                                label="dt_inicio"        />
    <campo campo="q202_dtfinal"                                  label="dt_fim"           />
    <campo campo="cnae.q71_descr"                                label="descricao_cnae"    />
    <campo campo="q136_salaoparceiro"                            label="salaoparceiro"     />
    <campo campo="q204_sequencial"                               label="sequencial_deducao"/>
    <campo campo="q204_inscr"                                    label="inscricao_deducao" />
    <campo campo="q204_estrutural"                               label="estrutural_deducao" />
    <campo campo="q204_deducao"                                  label="deducao_max"          />
    <campo campo="substr(q71_estrutural, 2)"                     label="cod_atividade"        />
    <campo campo="q136_exercicio"                                label="exercicio"/>
  </campos>
  <from tabela="issbasesalaoparceiro"/>
  <juncoes>
    <join tipo="inner" tabela="tabativ"                              condicao="q07_inscr = q202_inscr"/>
    <join tipo="inner" tabela="ativid"                               condicao="q07_ativ = q03_ativ"/>
    <join tipo="inner" tabela="atividcnae"                           condicao="q74_ativid = q03_ativ"/>
    <join tipo="left"  tabela="cnaeanalitica"                        condicao="q74_cnaeanalitica = q72_sequencial"/>
    <join tipo="inner" tabela="cnae"                                  condicao="q72_cnae = q71_sequencial"/>
    <join tipo="inner" tabela="issgruposervicoativid"                 condicao="q127_ativid = q03_ativ"/>
    <join tipo="inner" tabela="issconfiguracaogruposervico"           condicao="q127_issgruposerviso = q136_issgruposervico"/>
    <join tipo="inner" tabela="issgruposervico"                       condicao="q126_sequencial = q136_issgruposervico"/>
    <join tipo="inner" tabela="db_estruturavalor"                     condicao="q126_db_estruturavalor = db121_sequencial"/>
    <join tipo="left"  tabela="issbasededucaosalao"                   condicao="q204_inscr = q202_inscr and q204_estrutural = q71_estrutural"/>
  </juncoes>
  <filtros>
    <filtro   label=""      condicao = "q136_salaoparceiro = true" obrigatorio="true"/>
    <filtro   label=""      condicao = "q07_databx IS null" obrigatorio="true"/>
    <filtro   label="AnoUso"      condicao = "q136_exercicio = '$AnoUso'" obrigatorio="true"/>
    <filtro   label="q202_inscr"      condicao = "q202_inscr = '$q202_inscr'" obrigatorio="true"/>
    <filtro   label="dataServico"      condicao = "'$dataServico' >= q202_dtinicial " obrigatorio="true"/>
    <filtro   label="dataServico"    condicao = "(q202_dtfinal is null or q202_dtfinal >= '$dataServico'  )" obrigatorio="true"/>
    <filtro   label="atividade"    condicao = "q07_ativ = '$atividade'" obrigatorio="true"/>
  </filtros>
  <agrupamento campos=""         />
  <ordenacao   campos="q202_sequencial desc"/>
  <limit        limite="1"      />
</consulta>
