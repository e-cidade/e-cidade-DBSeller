        // processa ferias a partir do cadferias
	//

        $sqlferias = "delete from pontofs 
		      where r10_anousu = $anousu
                        and r10_mesusu = $mesusu
			and r10_rubric = '0516'
                        and r10_valor = 0
			and r10_regist in ($faixa_regis) ";
	$afasta_sqlf = pg_query($sqlferias);
	if( !$afasta_sqlf ){

	   echo "Erro ao apagar rubrica 0516-FERIAS no inicio do calculo.($sqlferias)";exit;

	}

        $sqlferias = "
	insert into pontofs 
        select distinct rh02_anousu,
                        rh02_mesusu,
               rhferias.rh109_regist,
                        '0516',
                        0,
                        30,
                        rh02_lota,
                        '',
                        rh02_instit
        from rhferiasperiodo
             inner join rhferias     on rhferias.rh109_sequencial = rhferiasperiodo.rh110_rhferias
             inner join rhpessoal    on rhpessoal.rh01_regist     = rhferias.rh109_regist
             inner join cgm          on rh01_numcgm = z01_numcgm
             inner join rhpessoalmov on rh02_anousu = $anousu
                                    and rh02_mesusu = $mesusu
                                    and rh02_regist = rh01_regist
             left join rhpesrescisao on rh02_seqpes = rh05_seqpes
        where rh110_datainicial >= '".($mesusu==12?$anousu+1:$anousu)."-".($mesusu==12?1:$mesusu+1)."-01'
          and rh110_datainicial <= fc_ultimodiames_data(".($mesusu==12?$anousu+1:$anousu).",".($mesusu==12?1:$mesusu+1).")
	  and rh05_seqpes is null
          and rh110_diaspagar > 0 
	  and rh110_pagaterco = 't'
	  and rh109_regist in ($faixa_regis) 
          and rh109_regist not in ( select r10_regist from pontofs 
                      where r10_anousu = $anousu
                        and r10_mesusu = $mesusu
                        and r10_rubric = '0516'
			and r10_regist in ($faixa_regis) )";

	$afasta_sqlf = pg_query($sqlferias);
	if( !$afasta_sqlf ){

	   echo "Erro ao incluir rubrica 0516-FERIAS no inicio do calculo.($sqlferias)";exit;

	}


        $sqlferias1 = "delete from pontofs 
  	               where r10_anousu = $anousu
                         and r10_mesusu = $mesusu
			 and r10_rubric = '0502' 
                         and r10_valor = 0
                         and r10_regist in ($faixa_regis) 
                         ";
	$afasta_sqlf = pg_query($sqlferias1);
	if( !$afasta_sqlf ){

	   echo "Erro ao apagar rubrica 0502-ABONO FERIAS no inicio do calculo.";exit;

	}


        $sqlferias1 = "
	insert into pontofs 
        select distinct rh02_anousu,
                        rh02_mesusu,
               rhferias.rh109_regist,
                        '0502',
                        0,
                        10,
                        rh02_lota,
                        '',
                        rh02_instit
        from rhferiasperiodo
             inner join rhferias  on rhferias.rh109_sequencial = rhferiasperiodo.rh110_rhferias
             inner join rhpessoal on rhpessoal.rh01_regist     = rhferias.rh109_regist
             inner join cgm       on rh01_numcgm = z01_numcgm
             inner join rhpessoalmov on rh02_anousu = $anousu
                                 and rh02_mesusu = $mesusu
                                 and rh02_regist = rh01_regist
             left join rhpesrescisao on rh02_seqpes = rh05_seqpes
        where rh110_datainicial >= '".($mesusu==12?$anousu+1:$anousu)."-".($mesusu==12?1:$mesusu+1)."-01'
          and rh110_datainicial <= fc_ultimodiames_data(".($mesusu==12?$anousu+1:$anousu).",".($mesusu==12?1:$mesusu+1).")
	
          and rh110_diasabono  > 0
          and rh05_seqpes is null
	  and rh110_pagaterco = 't' 
	  and rh109_regist in ($faixa_regis)
           and rh109_regist not in (
                       select r10_regist from pontofs 
                       where r10_anousu = $anousu
                         and r10_mesusu = $mesusu
                         and r10_rubric = '0502' 
                         and r10_regist in ($faixa_regis)) ";

	$afasta_sqlf = pg_query($sqlferias1);
