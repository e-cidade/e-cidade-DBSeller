<?xml version="1.0"?>
<Report>
    <Version>7.4</Version>
    <Properties>
        <Title></Title>
        <Author></Author>
        <Date></Date>
    </Properties>
    <Parameters>
        <nl01_codlanc>
            <mask></mask>
            <value></value>
            <label>nl01_codlanc</label>
            <options></options>
        </nl01_codlanc>
    </Parameters>
    <Header>
        <Body></Body>
    </Header>
    <Footer>
        <Body></Body>
    </Footer>
    <DataSet>
        <DataSource>
            <Name>Lancamento</Name>
        </DataSource>
        <Query>
            <Select>lancamento AS nl01_codlanc,        desc_ativp AS tt3,        obs AS texto,        texto1 AS relato,        texto2 AS infrigencia,        texto3 AS sansao,        texto4 AS baselegal,        inscr_iss AS insc_iss,        desc_dpto AS tt4,        p58ano AS tt5,        p58numero AS tt6,        identificacao AS vinculo_autuado,        codigo AS codigo_vinculo,        z01_nome AS nome_autuado,        z01_cgccpf AS cnpjcpf_autuado,        bairro_descr AS bairro_autuado,        j14_nome AS endereco_autuado,        nl02_numero AS numero_autuado,        z01_cep AS cep_autuado,  z01_munic as cidade_autuado,      nl02_compl AS complemento_autuado,        nl01_hora AS hora_inclusao,        nl01_data AS data_inclusao_extenso,    (SELECT tipo_procedencia    FROM fc_fis_lancamento_getprocedencias(lancamento, 2)) AS tt, (SELECT coalesce(valor_procedencia, 0) as multa_noti    FROM fc_fis_lancamento_getprocedencias(lancamento ,2)) as multa_notifica,   (SELECT coalesce(                      (SELECT valortotal_levantamento                       FROM fc_fis_lancamento_getimpostosservicos(lancamento, NULL)), 0) + coalesce(                                                                                          (SELECT valor_procedencia                                                                                           FROM fc_fis_lancamento_getprocedencias(lancamento ,2)), 0)) AS total_geral,

                (SELECT coalesce(
                     (SELECT valor_procedencia
                                                                                          FROM fc_fis_lancamento_getprocedencias(45 , 2)), 0) + coalesce(
                                                                                         (SELECT valor_procedencia
                                                                                          FROM fc_fis_lancamento_getprocedencias(45 , 1)), 0)) AS total_geral_proced,
                (SELECT coalesce(valor_procedencia, 0)    FROM fc_fis_lancamento_getprocedencias(lancamento , NULL)) AS total_procedencias,    (SELECT coalesce(valor_procedencia, 0)    FROM fc_fis_lancamento_getprocedencias(lancamento ,1)) AS valor_proced_tributo,    (SELECT coalesce(valor_procedencia, 0)    FROM fc_fis_lancamento_getprocedencias(lancamento ,2)) AS valor_proced_multa,    (SELECT coalesce(valorhistorico_levantamento, 0)    FROM fc_fis_lancamento_getimpostosservicos (lancamento, NULL)) AS total_historico,    (SELECT coalesce(valorcorrigido_levantamento, 0)    FROM fc_fis_lancamento_getimpostosservicos (lancamento, NULL)) AS total_corrigido,    (SELECT coalesce(valormulta_levantamento , 0)    FROM fc_fis_lancamento_getimpostosservicos (lancamento, NULL)) AS total_multa,    (SELECT coalesce(valorjuros_levantamento , 0)    FROM fc_fis_lancamento_getimpostosservicos (lancamento, NULL)) AS total_juros,    (SELECT coalesce(valortotal_levantamento , 0)    FROM fc_fis_lancamento_getimpostosservicos (lancamento, NULL)) AS total_levantamentos,    (SELECT coalesce(                      (SELECT valorcorrigido_levantamento                       FROM fc_fis_lancamento_getimpostosservicos(lancamento, NULL)), 0) + coalesce(                                                                                          (SELECT valor_procedencia                                                                                           FROM fc_fis_lancamento_getprocedencias(lancamento , NULL)), 0)) AS total_corrigidott, y100_sequencial</Select>
            <From>  (SELECT DISTINCT y100_sequencial,nl02_numero,                    nl01_obs AS obs,                    pr1.pl30_texto AS texto1,                    pr2.pl30_texto AS texto2,                    pr3.pl30_texto AS texto3,                    pr4.pl30_texto AS texto4,                    q02_inscr AS inscr_iss,                    q03_descr AS desc_ativp,                    descrdepto AS desc_dpto,                    p58_ano AS p58ano,                    protprocesso.p58_numero AS p58numero,                    nl02_compl,                    nl01_hora,                    nl01_data,                    j13_descr AS bairro_descr,                    z01_cep AS cepautuado,                   j14_nome,                    nl01_codlanc AS lancamento,                    CASE                        WHEN y30_codnoti IS NOT NULL THEN 'Notificação'                        ELSE (CASE WHEN q02_numcgm IS NOT NULL THEN 'Inscrição' ELSE (CASE WHEN y80_numcgm IS NOT NULL THEN 'Sanitário ' ELSE (CASE WHEN z01_numcgm IS NOT NULL THEN 'Cgm' ELSE (CASE WHEN j01_numcgm IS NOT NULL THEN 'Matrícula' ELSE 'Nenhum' END) END) END) END)                    END AS identificacao,                    CASE                        WHEN nl07_codnoti IS NOT NULL THEN nl07_codnoti                        ELSE (CASE WHEN nl05_matric IS NOT NULL THEN nl05_matric ELSE (CASE WHEN nl08_codsani IS NOT NULL THEN nl08_codsani ELSE (CASE WHEN z01_numcgm IS NOT NULL THEN z01_numcgm ELSE (CASE WHEN nl04_inscr IS NOT NULL THEN nl04_inscr END) END) END) END)                    END AS codigo,                    CASE                        WHEN q02_numcgm IS NOT NULL THEN q02_numcgm                        ELSE (CASE WHEN j01_numcgm IS NOT NULL THEN j01_numcgm ELSE (CASE WHEN y80_numcgm IS NOT NULL THEN y80_numcgm ELSE (CASE WHEN z01_numcgm IS NOT NULL THEN z01_numcgm ELSE q02_numcgm END) END) END)                    END AS z01_numcgm    FROM fiscalizacao.fis_lancamento    INNER JOIN fiscalizacao.fis_tipofiscaliza ON nl01_codtipo = y27_codtipo    LEFT  JOIN fiscalizacao.fis_lanccgm ON nl06_codlanc = nl01_codlanc    LEFT  JOIN fiscalizacao.fis_lancinscr ON nl04_codlanc = nl01_codlanc    LEFT  JOIN fiscalizacao.fis_lancmatric ON nl05_codlanc = nl01_codlanc    LEFT  JOIN fiscalizacao.fis_lancsanitario ON nl08_codlanc = nl01_codlanc    LEFT  JOIN iptubase ON j01_matric = nl05_matric    LEFT  JOIN issbase ON nl04_inscr = q02_inscr    LEFT  JOIN cgm ON z01_numcgm = nl06_numcgm    LEFT  JOIN fiscalizacao.fis_sanitario ON y80_codsani = nl08_codsani    LEFT  JOIN fiscalizacao.fis_lancfiscal ON nl07_codlanc = nl01_codlanc    LEFT  JOIN fiscalizacao.fis_fiscal ON nl07_codnoti = y30_codnoti    INNER JOIN fiscalizacao.fis_lanclocal ON nl02_codlanc = nl01_codlanc    LEFT  JOIN ruas ON j14_codigo = nl02_codigo    LEFT JOIN ativprinc ON q02_inscr = q88_inscr    LEFT JOIN tabativ ON q88_inscr = q07_inscr    AND q07_seq = q88_seq    LEFT JOIN ativid ON q07_ativ = q03_ativ    LEFT JOIN db_depart ON coddepto = nl01_setor    LEFT JOIN fiscalizacao.fis_procfiscallanc ON nl01_codlanc = nl09_lanc  LEFT JOIN fiscalizacao.fis_procfiscal on nl09_procfiscal = y100_sequencial

                LEFT JOIN fiscalizacao.fis_procfiscalprot ON y105_procfiscal = nl09_procfiscal    LEFT JOIN protprocesso ON p58_codproc = y105_protprocesso    LEFT JOIN fiscalizacao.fis_paragrafolanc pr1 ON pr1.pl30_codlanc = nl01_codlanc  AND pr1.pl30_paragrafo = 1    LEFT JOIN fiscalizacao.fis_paragrafolanc pr2 ON pr2.pl30_codlanc = nl01_codlanc      AND pr2.pl30_paragrafo = 2    LEFT JOIN fiscalizacao.fis_paragrafolanc pr3 ON pr3.pl30_codlanc = nl01_codlanc    AND pr3.pl30_paragrafo = 3    LEFT JOIN fiscalizacao.fis_paragrafolanc pr4 ON pr4.pl30_codlanc = nl01_codlanc    AND pr4.pl30_paragrafo = 4    LEFT  JOIN bairro ON j13_codi = nl02_codi ) AS subqueryauto INNER JOIN cgm ON cgm.z01_numcgm = subqueryauto.z01_numcgm</From>
            <Where>y100_sequencial between $procfiscalini and $procfiscalfim </Where>
            <GroupBy></GroupBy>
            <OrderBy></OrderBy>
        </Query>
        <Groups>
            <Config>
                <ShowGroup></ShowGroup>
                <ShowDetail>1</ShowDetail>
                <ShowLabel></ShowLabel>
                <ShowNumber></ShowNumber>
                <ShowIndent>1</ShowIndent>
                <ShowHeader></ShowHeader>
            </Config>
        </Groups>
